<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Type_Required_Before_Questionary</fullName>
    <active>true</active>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Shop_Request&quot; &amp;&amp;
