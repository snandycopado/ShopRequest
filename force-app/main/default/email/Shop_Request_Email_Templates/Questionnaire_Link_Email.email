<html xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Complete Your Shop Request Questionnaire</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:24px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width:480px;width:100%;background-color:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 4px rgba(20,24,40,0.08);">
        <tr>
          <td style="background-color:#161b33;padding:24px 32px;">
            <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:0.2px;">Shop Request Management</span>
          </td>
        </tr>
        <tr>
          <td style="padding:32px 32px 8px 32px;">
            <p style="font-size:16px;color:#161b33;margin:0 0 16px 0;">Hello,</p>
            <p style="font-size:15px;color:#4a5169;line-height:1.6;margin:0 0 24px 0;">
              Thank you for submitting shop request <strong>{!Case.CaseNumber}</strong>. Before we can move forward,
              please complete a short questionnaire about your request.
            </p>
            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px auto;">
              <tr>
                <td align="center" style="border-radius:8px;background-color:#3457d5;">
                  <a href="{!Case.Questionnaire_Link__c}" target="_blank"
                     style="display:inline-block;padding:14px 32px;font-size:15px;color:#ffffff;text-decoration:none;font-weight:bold;">
                    Start Questionnaire
                  </a>
                </td>
              </tr>
            </table>
            <p style="font-size:13px;color:#8990a3;line-height:1.6;margin:0 0 8px 0;">
              For your security, we'll email you a one-time verification code as soon as you open the link.
            </p>
            <p style="font-size:13px;color:#8990a3;line-height:1.6;margin:0;">
              If the button above doesn't work, copy and paste this link into your browser:<br/>
              <a href="{!Case.Questionnaire_Link__c}" style="color:#3457d5;word-break:break-all;">{!Case.Questionnaire_Link__c}</a>
            </p>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 32px;background-color:#f4f5f7;">
            <p style="font-size:12px;color:#8990a3;margin:0;">This is an automated message - please do not reply to this email.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
